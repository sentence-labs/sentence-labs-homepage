---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sentence Labs</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <img class="mark" src="/logo.svg" alt="Sentence Labs" />
      <h1>Sentence Labs</h1>
      <p>An applied research lab building infrastructure for real-time, structured interaction.</p>
      <a class="contact" href="mailto:hi@sentence-labs.com">hello@sentence-labs.com</a>
