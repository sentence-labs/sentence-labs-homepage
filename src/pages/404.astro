---
import '../styles/global.css';

const title = '404 — Sentence Labs';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A0A08" />
  </head>
  <body>
    <main>
      <img class="mark" src="/logo.svg" alt="" width="56" height="56" />
      <h1>404</h1>
      <p>That page doesn't exist.</p>
      <a class="contact" href="/">Back to home</a>
    </main>

    <footer>Sentence Labs Private Limited &middot; &copy; 2026</footer>
  </body>
</html>
